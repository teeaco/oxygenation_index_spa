{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for guest tauri app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "http:default",
    "cors-fetch:default",
    "http:allow-fetch",
    "http:allow-fetch-read-body",
    "http:allow-fetch-send",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://192.168.195.38/**"
        }
      ],
      "deny": []
    }
  ]
}
